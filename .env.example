# =============================================================================
# TransitOps – Smart Transport Operations Platform
# Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your development or production credentials.
# Do NOT commit actual secrets or private keys to source control.
# =============================================================================

# Clerk Authentication
# Clerk Publishable Key (find in Clerk Dashboard -> API Keys)
# Format: pk_test_... (development) or pk_live_... (production)
VITE_CLERK_PUBLISHABLE_KEY=

# Supabase Integration
# Supabase Project URL (find in Supabase Project Settings -> API)
# Format: https://<project-ref>.supabase.co
VITE_SUPABASE_URL=

# Supabase Public/Publishable Key (Anon public API key)
# Safe for browser client use; protected by Postgres Row Level Security (RLS)
VITE_SUPABASE_PUBLISHABLE_KEY=

# Clerk JWT Template for Supabase
# Name of the JWT template configured in Clerk Dashboard (JWT Templates -> New -> Supabase)
# Default typically: supabase
VITE_CLERK_JWT_TEMPLATE=

